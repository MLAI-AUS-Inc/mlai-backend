# Required immutable images. These multi-architecture digests were resolved from
# the official registries for the named tags. Upgrade them deliberately and test
# backup/restore plus API compatibility before changing production.
UMAMI_IMAGE=docker.umami.is/umami-software/umami:3.2.0@sha256:8edfe4beaef13f9d1300619fa264ef250a3688df9cc54d24ca830ca31cb475ec
ANALYTICS_POSTGRES_IMAGE=postgres:16.14-alpine3.23@sha256:42b8b8b29c8a4e933d88943e5b03001a78794905cf786e6e7634e9f2abd5a0d3

ANALYTICS_POSTGRES_DB=umami
ANALYTICS_POSTGRES_USER=umami
# Generate a URL-safe value: openssl rand -hex 32
ANALYTICS_POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-32
# Generate independently: openssl rand -hex 32
UMAMI_APP_SECRET=replace-with-output-of-openssl-rand-hex-32

# The full Umami UI/API binds to loopback. A same-host TLS reverse proxy exposes
# only the two public routes below; operators use VPN or an SSH tunnel for admin.
UMAMI_BIND_HOST=127.0.0.1
UMAMI_PORT=3000

# Keep these paths synchronized with the exact public-ingress allowlist.
UMAMI_TRACKER_SCRIPT_NAME=content-signal.js
UMAMI_COLLECT_API_ENDPOINT=/api/content-signal
UMAMI_CORS_MAX_AGE=86400

# The ingress must overwrite this header. nginx-public.example.conf uses
# X-Real-IP. If a trusted CDN terminates TLS, configure its real-IP module first.
UMAMI_CLIENT_IP_HEADER=X-Real-IP
UMAMI_IGNORE_IP=

# Raw Umami events are pruned only after a recent backup. MLAI's daily aggregate
# tables retain report history independently of this raw-data window.
ANALYTICS_RAW_RETENTION_DAYS=120
ANALYTICS_BACKUP_RETENTION_DAYS=30

# Must match the external network used by mlai-backend.
MLAI_SHARED_NETWORK=mlai-shared
