# Required immutable images. These multi-architecture digests were resolved
# from Docker Hub for the named tags on 23 October 2026. Upgrade them
# deliberately: listmonk migrates its schema on start, so take and check a dump
# first and test the new digest with the crm sync before changing production.
LISTMONK_IMAGE=listmonk/listmonk:v6.2.0@sha256:f535d59e14991337a9f2d570273685378ae86b0d7698c3e00da444e3bc205286
LISTMONK_POSTGRES_IMAGE=postgres:17.11-alpine3.24@sha256:eee6c6e1b0894fa4fe0075eb054af9fd1cf39a35321c2d4110626cfe506411fb

LISTMONK_POSTGRES_DB=listmonk
LISTMONK_POSTGRES_USER=listmonk
# Generate a URL-safe value: openssl rand -hex 32
LISTMONK_POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-32

# Leave both empty: the first visit to the admin UI (over the SSH tunnel) then
# creates the super admin. If set, they are read only on the first start;
# remove them after the first login. Turn on two-factor authentication.
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=

# listmonk drops root to this user and group inside the container.
LISTMONK_PUID=1000
LISTMONK_PGID=1000

# The admin UI and API bind to loopback; reach them over an SSH tunnel. The
# public ingress (nginx-public-cloudflare-proxied.conf) proxies only the
# subscriber routes to this port.
LISTMONK_BIND_HOST=127.0.0.1
LISTMONK_PORT=9100

LISTMONK_BACKUP_RETENTION_DAYS=30

# Must match the external network used by mlai-backend.
MLAI_SHARED_NETWORK=mlai-shared
