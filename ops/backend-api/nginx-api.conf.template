# managed-mlai-backend-api target=@TARGET@
# Cloudflare terminates HTTPS and reaches this origin on HTTP port 80.
# The analytics vhost loads Cloudflare's trusted real-IP ranges at HTTP scope.
map $http_upgrade $mlai_api_connection_upgrade {
    default upgrade;
    '' close;
}
map $http_x_forwarded_proto $mlai_api_forwarded_proto {
    https https;
    default http;
}

server {
    listen @LISTEN_PORT@;
    listen [::]:@LISTEN_PORT@;
    server_name api.mlai.au;
    include @REAL_IP_CONFIG@;
    real_ip_header CF-Connecting-IP;
    client_max_body_size 260m;
    keepalive_timeout 5s;

    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $mlai_api_forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mlai_api_connection_upgrade;
        add_header X-MLAI-Origin-Web-Slot @TARGET@ always;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
