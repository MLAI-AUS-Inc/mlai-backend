DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000

# --- Security: cryptographic keys (REQUIRED in production) --------------------
# Django signing key, also used to sign JWT access/refresh tokens. MUST be a
# unique, random, secret value in production -- the app refuses to boot in prod
# without it (and never falls back to the committed dev key).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Dedicated key for encrypting connector OAuth tokens at rest, decoupled from
# SECRET_KEY so the two rotate independently. When unset, the field key is
# derived from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Retained ONLY to decrypt tokens written under a previous key while migrating.
# After deploying a new key, run `manage.py reencrypt_secrets --apply`, then clear this.
LEGACY_FIELD_ENCRYPTION_SECRET=
# Versioned connector keyring. Production requires a non-empty JSON object and
# an active key ID present in that object. Keep old keys until rotation finishes.
# Generate each value with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_CREDENTIAL_KEYS=
CONNECTOR_CREDENTIAL_ACTIVE_KEY_ID=

# User-authorized Slack connection used by Community Home's one-click
# consent-gated DM migration. The Slack app must request these as user scopes
# and subscribe to the message.im and message.mpim user events at the bridge
# request URL.
FT_SLACK_CLIENT_ID=
FT_SLACK_CLIENT_SECRET=
FT_SLACK_OAUTH_REDIRECT_URI=https://api.mlai.au/integrations/callback/slack
SLACK_OAUTH_USER_SCOPES=channels:history,channels:read,groups:history,groups:read,im:history,im:read,im:write,mpim:history,mpim:read,mpim:write,chat:write,team:read,users:read,reactions:read,reactions:write,files:read
SLACK_DM_MIRROR_HISTORY_DAYS=30
SLACK_DM_MIRROR_DELIVERY_BATCH_SIZE=20
SLACK_DM_MIRROR_SHADOW_SECRET=

# Raw Slack/community bridge webhook bodies are automatically cleared after
