DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Credentialed browser origins. admin.mlai.au is deliberately absent because
# Plane must never receive browser authority to call the MLAI API with cookies.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://mlai.au,https://www.mlai.au,https://victorai.win,https://www.victorai.win,https://ops.mlai.au,https://chat.mlai.au
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://mlai.au,https://www.mlai.au,https://api.mlai.au,https://ops.mlai.au,https://chat.mlai.au
