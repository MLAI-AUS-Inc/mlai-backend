MONTHLY_UPDATE_REMINDERS_QUEUE_DRAFT=true
CUSTOMERIO_MONTHLY_UPDATE_7D_TEMPLATE_ID=
CUSTOMERIO_MONTHLY_UPDATE_1D_TEMPLATE_ID=
MONTHLY_UPDATE_REMINDER_APP_URL=https://mlai.au
# Signed daily-email actions expire after 48 hours by default. Email GETs are
# read-only confirmation pages; the human-confirmed POST performs the action.
CONTENT_AUTOMATION_EMAIL_ACTION_MAX_AGE_SECONDS=172800
RESEND_API_KEY=
RESEND_FROM_EMAIL=Roo <notifications@mlai.au>
# Twilio WhatsApp (Console -> Messaging -> Senders -> WhatsApp Senders).
# The auth token also validates inbound webhook signatures (X-Twilio-Signature).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled Twilio number in E.164, e.g. +61480012345.
TWILIO_WHATSAPP_FROM=
# Approved Content template SIDs (HX..., Console -> Content Template Builder).
# OTP verification returns 503 until TWILIO_WHATSAPP_OTP_CONTENT_SID is set to
# an approved AUTHENTICATION template (variable {{1}} = code).
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# UTILITY template with variables {{1}} domain, {{2}}-{{4}} topic titles.
TWILIO_WHATSAPP_TOPIC_CONTENT_SID=
# Analytics-lead daily-topics template ({{1}} domain, {{2}} performance summary,
# {{3}}-{{5}} topic titles). Wins over TWILIO_WHATSAPP_TOPIC_CONTENT_SID when
# set; only set after the template is APPROVED in Twilio.
TWILIO_WHATSAPP_TOPIC_ANALYTICS_CONTENT_SID=
# UTILITY template with variables {{1}} article title, {{2}} domain, and {{3}}
# expanded review URL. Include "Reply STOP to opt out." in the fixed template copy.
TWILIO_WHATSAPP_REVIEW_CONTENT_SID=
# How long email verification links stay valid (seconds).
NOTIFICATION_CHANNEL_VERIFY_MAX_AGE_SECONDS=259200
# MLAI Chat device bootstrap. Generate independent, high-entropy values for
# the adapter bearer token and Nostr service key; never reuse relay/Slack keys.
COMMUNITY_CHAT_RELAY_URL=wss://chat.mlai.au
COMMUNITY_CHAT_API_AUDIENCE=https://api.mlai.au
COMMUNITY_CHAT_ADAPTER_URL=http://127.0.0.1:3100
COMMUNITY_CHAT_ADAPTER_TOKEN=
COMMUNITY_CHAT_ADAPTER_TIMEOUT_SECONDS=5
COMMUNITY_CHAT_CHALLENGE_TTL_SECONDS=300
COMMUNITY_CHAT_DEVICE_AUTH_TTL_SECONDS=900
COMMUNITY_CHAT_BOOTSTRAP_TOKEN_TTL_SECONDS=300
# Browser email codes remain the human proof for desktop sign-in. Password
# authentication stays disabled; the PKCE browser-to-desktop handoff is
# required in staging and production.
COMMUNITY_CHAT_PASSWORD_AUTH_ENABLED=false
COMMUNITY_CHAT_DEVICE_AUTH_ENABLED=true
COMMUNITY_CHAT_EMAIL_CODE_AUTH_ENABLED=true
COMMUNITY_CHAT_EMAIL_CODE_TTL_SECONDS=600
COMMUNITY_CHAT_EMAIL_CODE_MAX_ATTEMPTS=5
COMMUNITY_CHAT_EMAIL_CODE_RESEND_SECONDS=60
COMMUNITY_CHAT_EMAIL_CODE_MIN_RESPONSE_SECONDS=0.12
COMMUNITY_CHAT_EMAIL_CODE_PEPPER=replace-with-an-independent-random-secret
COMMUNITY_CHAT_EMAIL_CODE_DELIVERY_SECRET=replace-with-an-independent-random-secret
COMMUNITY_CHAT_SESSION_ACCESS_TTL_SECONDS=900
COMMUNITY_CHAT_SESSION_REFRESH_TTL_DAYS=30
TOKEN_USAGE_API_BASE=https://api.mlai.au/api/v1/community-chat/usage
TOKEN_USAGE_TIME_ZONE=Australia/Melbourne
TOKEN_USAGE_LEADERBOARD_TIME_ZONE=UTC
TOKENMAXER_FEDERATION_ENABLED=true
TOKENMAXER_PUBLIC_API_BASE=https://tokenmaxer.quest
TOKENMAXER_FEDERATION_TIMEOUT_SECONDS=3
TOKENMAXER_FEDERATION_CACHE_SECONDS=600
TOKEN_USAGE_INGEST_RATE=120/minute
TOKEN_USAGE_HISTORY_RATE=20/minute
TOKEN_USAGE_TOKEN_RATE=10/minute
TOKEN_USAGE_LEADERBOARD_RATE=60/minute
COMMUNITY_CHAT_HOME_RATE=60/minute
COMMUNITY_CHAT_UPCOMING_EVENTS_RATE=60/minute
MEETING_ROOM_BOOKING_ENABLED=false
CUSTOMERIO_COMMUNITY_CHAT_CODE_MESSAGE_ID=
COMMUNITY_CHAT_FRONTEND_URL=https://chat.mlai.au
# App-level origin binding includes the Flutter callback and Tauri webviews.
# Tauri Community Chat CORS is credential-free in DesktopAuthCorsMiddleware,
# so these native origins must not be added to global credentialed CORS above.
COMMUNITY_CHAT_ALLOWED_ORIGINS=https://chat.mlai.au,http://localhost:3001,http://localhost:5173,http://127.0.0.1:4173,tauri://localhost,http://tauri.localhost,mlaichat://callback
COMMUNITY_CHAT_PASSWORD_RESET_URL=https://chat.mlai.au/#/reset-password
# Server-only Luma calendar access for authenticated MLAI Chat event cards.
# The key grants full access to its calendar: keep it out of all VITE/browser
# variables and rotate it immediately if it is ever exposed.
LUMA_API_KEY=
LUMA_BASE_URL=https://public-api.luma.com
LUMA_CALENDAR_URL=https://luma.com/mlai_au
LUMA_API_TIMEOUT_SECONDS=5
LUMA_UPCOMING_EVENTS_CACHE_SECONDS=300
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_MIN_RESPONSE_SECONDS=0.12
PASSWORD_RESET_DELIVERY_SECRET=replace-with-a-stable-random-secret
CUSTOMERIO_PASSWORD_RESET_MESSAGE_ID=2

# --- Committee weekly points remuneration -------------------------------------
# Pays every active PointsAdmin with role='committee' a fixed weekly points
# allocation. The award is keyed to the ISO week, so the hourly container loop
# pays once per week and a missed run self-heals on the next tick.
# Start with the test channel, confirm one run, then switch to #mlai-committee-2026.
COMMITTEE_REMUNERATION_ENABLED=false
COMMITTEE_REMUNERATION_WEEKLY_POINTS=40
COMMITTEE_REMUNERATION_SLACK_CHANNEL=#roo-testing
COMMITTEE_REMUNERATION_TIMEZONE=Australia/Melbourne
