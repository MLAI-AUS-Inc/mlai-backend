DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Security: cryptographic keys (REQUIRED in production) --------------------
# Django signing key, also used to sign JWT access/refresh tokens. MUST be a
# unique, random, secret value in production -- the app refuses to boot in prod
# without it (and never falls back to the committed dev key).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Dedicated key for encrypting connector OAuth tokens at rest, decoupled from
# SECRET_KEY so the two rotate independently. When unset, the field key is
# derived from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Retained ONLY to decrypt tokens written under a previous key while migrating.
# After deploying a new key, run `manage.py reencrypt_secrets --apply`, then clear this.
LEGACY_FIELD_ENCRYPTION_SECRET=

DATABASE_URL=
WATT_THE_HACK_URL=
WATT_HACKATHON_CLASS_ID=WATT
WATT_HACKATHON_API_BASE_URL=
WATT_UNITY_SESSION_TICKET_TTL_SECONDS=900
WATT_UNITY_TICKET_REDEEM_RATE=60/minute
VAGON_STREAM_ID=
VAGON_STREAM_URL=

# Optional shared cache (Redis/Valkey). When set (and redis-py is installed), Django uses RedisCache
# for the default + watt_session caches — a real cache shared across all gunicorn workers. REQUIRED in
# multi-worker prod so a Unity session ticket minted by one worker is redeemable by another (otherwise
# the per-process LocMemCache 404s the redeem). Unset -> falls back to LocMemCache + Postgres DB cache.
# DO managed Valkey: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Content Factory service-to-service calls
CONTENT_FACTORY_URL=http://localhost:8001
CONTENT_FACTORY_API_KEY=

# Health Hack simulated-patient gateway
# Production Roo private VPC address: http://10.126.0.5
ROO_SERVICE_URL=
# Optional bearer token sent from Django to Roo when Roo enables auth.
ROO_SIM_PATIENT_KEY=
# Dedicated bearer token accepted from the Health Hack Cloudflare Worker.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEALTH_HACK_API_KEY=

# MLAI Tools GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Keep OAuth credentials for connect/reconnect and repo listing.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/callback/github

# Core providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Daily research reminder notification channels
# Email: Customer.io is preferred when its key is set (same App API key the
# magic-link emails already use); Resend is the fallback transport.
CUSTOMERIO_API_KEY=
# Optional explicit from-address for Customer.io sends; workspace default otherwise.
CUSTOMERIO_FROM_EMAIL=
# Transactional message id of the daily-topics template (see
# docs/customerio-daily-topics-email.html). When set, the daily email renders
# through that template (Liquid loop over message_data.topics); without it the
# send falls back to a raw HTML body.
CUSTOMERIO_TOPIC_TEMPLATE_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Roo <notifications@mlai.au>
# Twilio WhatsApp (Console -> Messaging -> Senders -> WhatsApp Senders).
# The auth token also validates inbound webhook signatures (X-Twilio-Signature).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled Twilio number in E.164, e.g. +61480012345.
TWILIO_WHATSAPP_FROM=
# Approved Content template SIDs (HX..., Console -> Content Template Builder).
# OTP verification returns 503 until TWILIO_WHATSAPP_OTP_CONTENT_SID is set to
# an approved AUTHENTICATION template (variable {{1}} = code).
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# UTILITY template with variables {{1}} domain, {{2}}-{{4}} topic titles.
TWILIO_WHATSAPP_TOPIC_CONTENT_SID=
# UTILITY template with variables {{1}} article title, {{2}} domain, and {{3}}
# expanded review URL. Include "Reply STOP to opt out." in the fixed template copy.
TWILIO_WHATSAPP_REVIEW_CONTENT_SID=
# How long email verification links stay valid (seconds).
NOTIFICATION_CHANNEL_VERIFY_MAX_AGE_SECONDS=259200
