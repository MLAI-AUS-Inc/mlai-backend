# Shared Redis/Valkey cache. REQUIRED in production so quotas, in-flight locks,
# spending caps, and Unity session tickets work across all gunicorn workers.
# Local development may leave this blank and use process-local/database caches.
# DO managed Valkey: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Content Factory service-to-service calls
CONTENT_FACTORY_URL=http://localhost:8001
CONTENT_FACTORY_API_KEY=

# Health Hack simulated-patient gateway
# Production Roo private VPC address: http://10.126.0.5
ROO_SERVICE_URL=
# Dedicated bearer token sent from Django to Roo. The Health Hack gateway
# returns 503 rather than calling Roo when this credential is absent.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROO_SIM_PATIENT_KEY=
# Dedicated bearer token accepted from the Health Hack Cloudflare Worker.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEALTH_HACK_API_KEY=
# Separate service credential Roo uses to record diagnosis verdicts. Never
# reuse either gateway credential above for this higher-privilege endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROO_API_KEY=

# Read-only Victor application access for Roo. Channel selection is enforced by
# Roo using the configured Slack channel name, so no Slack IDs are needed here.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VICTOR_AI_ROO_ENABLED=false
VICTOR_AI_ROO_SIGNING_SECRET=
VICTOR_AI_ROO_ASSERTION_MAX_AGE_SECONDS=60
VICTOR_AI_ROO_ASSERTION_CLOCK_SKEW_SECONDS=5
VICTOR_AI_ROO_EXPORT_MAX_ROWS=5000
HEALTH_HACK_ACTIVE_CASE_ID=1
HEALTH_HACK_FREE_TICKET_URL=https://luma.com/mlai-8obe?coupon=RQY4N0
HEALTH_HACK_DISCOUNT_URL=https://luma.com/mlai-8obe?coupon=ALMOSTGOTIT

# Keep participant/network abuse controls in observation mode until production
# traffic establishes safe thresholds. The global spend budget is always a hard
# circuit breaker at its generous daily maximum.
HEALTH_HACK_AI_RATE_LIMIT_MODE=observe
HEALTH_HACK_AI_BUDGET_MODE=enforce
HEALTH_HACK_AI_KILL_SWITCH=false
HEALTH_HACK_AI_PARTICIPANT_BURST_LIMIT=3
HEALTH_HACK_AI_PARTICIPANT_10M_LIMIT=40
HEALTH_HACK_AI_PARTICIPANT_HOURLY_LIMIT=100
# Network ceilings are intentionally much higher for shared venue Wi-Fi.
HEALTH_HACK_AI_NETWORK_BURST_LIMIT=60
HEALTH_HACK_AI_NETWORK_10M_LIMIT=400
HEALTH_HACK_AI_NETWORK_HOURLY_LIMIT=1000
HEALTH_HACK_AI_DAILY_CALL_LIMIT=5000
HEALTH_HACK_AI_DAILY_TOKEN_LIMIT=5000000
HEALTH_HACK_AI_INFLIGHT_TTL_SECONDS=35
HEALTH_HACK_AI_PENDING_TTL_SECONDS=35
HEALTH_HACK_AI_BODY_MAX_BYTES=16384
HEALTH_HACK_AI_UPSTREAM_MAX_BYTES=32768
HEALTH_HACK_DIAGNOSIS_UPSTREAM_MAX_BYTES=8192
HEALTH_HACK_AI_REPLY_MAX_CHARS=1500
HEALTH_HACK_AI_REPLY_MAX_WORDS=160
# These two values form the worst-case per-call reservation against the hard
# daily token ceiling. Keep them aligned with Roo's model request contract.
HEALTH_HACK_AI_MAX_PROMPT_TOKENS=12000
HEALTH_HACK_AI_MAX_COMPLETION_TOKENS=2000
HEALTH_HACK_CHAT_RETENTION_DAYS=30

# Anonymous Content Factory article analytics
# Private Umami API origin on the shared Docker network. Never emit this value
# into generated pages.
UMAMI_BASE_URL=http://content-analytics-umami:3000
# Umami v3.2 has login bearer tokens, not separately scoped API keys. Prefer a
# dedicated service user's credentials; API_TOKEN may hold its current bearer.
UMAMI_API_TOKEN=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_TEAM_ID=
# Public browser-safe values. HOST_URL is an origin, not the collection path.
