DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Security: cryptographic keys (REQUIRED in production) --------------------
# Django signing key, also used to sign JWT access/refresh tokens. MUST be a
# unique, random, secret value in production -- the app refuses to boot in prod
# without it (and never falls back to the committed dev key).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Dedicated key for encrypting connector OAuth tokens at rest, decoupled from
# SECRET_KEY so the two rotate independently. When unset, the field key is
# derived from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Retained ONLY to decrypt tokens written under a previous key while migrating.
# After deploying a new key, run `manage.py reencrypt_secrets --apply`, then clear this.
LEGACY_FIELD_ENCRYPTION_SECRET=

DATABASE_URL=
WATT_THE_HACK_URL=
HOSPITAL_SLACK_CHANNEL_NAME=healthhack
# Optional comma-separated Slack IDs for organisers who may publish HealthHack
# announcements without Django superuser status. Each ID must already be linked
# to an active mlai-backend user.
HEALTHHACK_ANNOUNCEMENT_ADMIN_IDS=
WATT_HACKATHON_CLASS_ID=WATT
WATT_HACKATHON_API_BASE_URL=
WATT_UNITY_SESSION_TICKET_TTL_SECONDS=900
WATT_UNITY_TICKET_REDEEM_RATE=60/minute
VAGON_STREAM_ID=
VAGON_STREAM_URL=

# Shared Redis/Valkey cache. REQUIRED in production so quotas, in-flight locks,
# spending caps, and Unity session tickets work across all gunicorn workers.
# Local development may leave this blank and use process-local/database caches.
# DO managed Valkey: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Content Factory service-to-service calls
CONTENT_FACTORY_URL=http://localhost:8001
CONTENT_FACTORY_API_KEY=

# Health Hack simulated-patient gateway
# Production Roo private VPC address: http://10.126.0.5
ROO_SERVICE_URL=
# Dedicated bearer token sent from Django to Roo. The Health Hack gateway
# returns 503 rather than calling Roo when this credential is absent.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROO_SIM_PATIENT_KEY=
# Dedicated bearer token accepted from the Health Hack Cloudflare Worker.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEALTH_HACK_API_KEY=
# Separate service credential Roo uses to record diagnosis verdicts. Never
# reuse either gateway credential above for this higher-privilege endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROO_API_KEY=
HEALTH_HACK_ACTIVE_CASE_ID=1
HEALTH_HACK_FREE_TICKET_URL=https://luma.com/mlai-8obe?coupon=RQY4N0
HEALTH_HACK_DISCOUNT_URL=https://luma.com/mlai-8obe?coupon=ALMOSTGOTIT

# Keep participant/network abuse controls in observation mode until production
# traffic establishes safe thresholds. The global spend budget is always a hard
# circuit breaker at its generous daily maximum.
HEALTH_HACK_AI_RATE_LIMIT_MODE=observe
HEALTH_HACK_AI_BUDGET_MODE=enforce
HEALTH_HACK_AI_KILL_SWITCH=false
HEALTH_HACK_AI_PARTICIPANT_BURST_LIMIT=3
HEALTH_HACK_AI_PARTICIPANT_10M_LIMIT=40
HEALTH_HACK_AI_PARTICIPANT_HOURLY_LIMIT=100
# Network ceilings are intentionally much higher for shared venue Wi-Fi.
HEALTH_HACK_AI_NETWORK_BURST_LIMIT=60
HEALTH_HACK_AI_NETWORK_10M_LIMIT=400
HEALTH_HACK_AI_NETWORK_HOURLY_LIMIT=1000
HEALTH_HACK_AI_DAILY_CALL_LIMIT=5000
HEALTH_HACK_AI_DAILY_TOKEN_LIMIT=5000000
HEALTH_HACK_AI_INFLIGHT_TTL_SECONDS=35
HEALTH_HACK_AI_PENDING_TTL_SECONDS=35
HEALTH_HACK_AI_BODY_MAX_BYTES=16384
HEALTH_HACK_AI_UPSTREAM_MAX_BYTES=32768
HEALTH_HACK_DIAGNOSIS_UPSTREAM_MAX_BYTES=8192
HEALTH_HACK_AI_REPLY_MAX_CHARS=1500
HEALTH_HACK_AI_REPLY_MAX_WORDS=160
# These two values form the worst-case per-call reservation against the hard
# daily token ceiling. Keep them aligned with Roo's model request contract.
HEALTH_HACK_AI_MAX_PROMPT_TOKENS=12000
HEALTH_HACK_AI_MAX_COMPLETION_TOKENS=2000
HEALTH_HACK_CHAT_RETENTION_DAYS=30

# Anonymous Content Factory article analytics
# Private Umami API origin on the shared Docker network. Never emit this value
# into generated pages.
UMAMI_BASE_URL=http://content-analytics-umami:3000
# Umami v3.2 has login bearer tokens, not separately scoped API keys. Prefer a
# dedicated service user's credentials; API_TOKEN may hold its current bearer.
UMAMI_API_TOKEN=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_TEAM_ID=
# Public browser-safe values. HOST_URL is an origin, not the collection path.
CONTENT_ANALYTICS_TRACKER_SCRIPT_URL=https://analytics.example.com/content-signal.js
CONTENT_ANALYTICS_HOST_URL=https://analytics.example.com
CONTENT_ANALYTICS_FIRST_PARTY_PROXY_ENABLED=false
CONTENT_ANALYTICS_SYNC_ENABLED=true
# Completed days are due daily. The worker polls hourly so bounded initial GSC
# backfills progress promptly while steady-state sites are skipped.
CONTENT_ANALYTICS_SYNC_INTERVAL_SECONDS=86400
CONTENT_ANALYTICS_SYNC_POLL_SECONDS=3600
CONTENT_ANALYTICS_SYNC_BATCH_LIMIT=10
CONTENT_ANALYTICS_SYNC_LOOKBACK_DAYS=3
CONTENT_ANALYTICS_SYNC_MAX_BACKFILL_DAYS_PER_RUN=30
# Number of top UTM sources enriched with exact visit counts per article/day.
# Overall CTA metrics stay exact; expensive per-source CTA joins are deferred.
CONTENT_ANALYTICS_UMAMI_SOURCE_ATTRIBUTION_LIMIT=3
CONTENT_ANALYTICS_GSC_FINALIZATION_LAG_DAYS=3
CONTENT_ANALYTICS_GSC_INITIAL_BACKFILL_DAYS=480
CONTENT_ANALYTICS_GSC_QUERY_LIMIT=100
# Prefer a secret file mounted into web + analytics-sync. JSON must be one line
# when the deployment platform cannot mount a file.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=

# MLAI Tools GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Keep OAuth credentials for connect/reconnect and repo listing.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/callback/github

# Core providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Stripe payout -> Xero reconciliation
# Pin a real Stripe API version value; do not paste a Python settings expression.
STRIPE_API_VERSION=2026-02-25.clover
RECONCILIATION_DEFAULT_DOMAIN=mlai.au
RECONCILIATION_SCHEDULER_ENABLED=true
# The Xero OAuth scope list must include accounting.banktransactions before an
# admin can approve a payout for posting, and accounting.settings so approved
# Event Name / Project Name tracking options can be created when missing.
# Existing connections need reconnecting after either scope is added.
XERO_OAUTH_SCOPES=offline_access,accounting.invoices.read,accounting.payments.read,accounting.payments,accounting.settings.read,accounting.settings,accounting.contacts.read,accounting.banktransactions
XERO_STATEMENT_AUTO_POST_ENABLED=false
XERO_STATEMENT_BANK_TRANSACTION_MIN_CONFIDENCE=0.92
XERO_STATEMENT_BILL_PAYMENT_MIN_CONFIDENCE=0.98

# Daily research reminder notification channels
# Email: Customer.io is preferred when its key is set (same App API key the
# magic-link emails already use); Resend is the fallback transport.
CUSTOMERIO_API_KEY=
# Optional explicit from-address for Customer.io sends; workspace default otherwise.
CUSTOMERIO_FROM_EMAIL=
# Transactional message id of the Victor:AI completed-registration receipt.
CUSTOMERIO_VICTOR_REGISTRATION_TEMPLATE_ID=4
# Transactional message id of the daily-topics template (see
# docs/customerio-daily-topics-email.html). When set, the daily email renders
# through that template (Liquid loop over trigger.topics); without it the
# send falls back to a raw HTML body.
CUSTOMERIO_TOPIC_TEMPLATE_ID=3
# Signed daily-email actions expire after 48 hours by default. Email GETs are
# read-only confirmation pages; the human-confirmed POST performs the action.
CONTENT_AUTOMATION_EMAIL_ACTION_MAX_AGE_SECONDS=172800
RESEND_API_KEY=
RESEND_FROM_EMAIL=Roo <notifications@mlai.au>
# Twilio WhatsApp (Console -> Messaging -> Senders -> WhatsApp Senders).
# The auth token also validates inbound webhook signatures (X-Twilio-Signature).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled Twilio number in E.164, e.g. +61480012345.
TWILIO_WHATSAPP_FROM=
# Approved Content template SIDs (HX..., Console -> Content Template Builder).
# OTP verification returns 503 until TWILIO_WHATSAPP_OTP_CONTENT_SID is set to
# an approved AUTHENTICATION template (variable {{1}} = code).
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# UTILITY template with variables {{1}} domain, {{2}}-{{4}} topic titles.
TWILIO_WHATSAPP_TOPIC_CONTENT_SID=
# UTILITY template with variables {{1}} article title, {{2}} domain, and {{3}}
# expanded review URL. Include "Reply STOP to opt out." in the fixed template copy.
TWILIO_WHATSAPP_REVIEW_CONTENT_SID=
# How long email verification links stay valid (seconds).
NOTIFICATION_CHANNEL_VERIFY_MAX_AGE_SECONDS=259200
