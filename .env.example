DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
WATT_THE_HACK_URL=
WATT_HACKATHON_CLASS_ID=WATT
WATT_HACKATHON_API_BASE_URL=
WATT_UNITY_SESSION_TICKET_TTL_SECONDS=900
WATT_UNITY_TICKET_REDEEM_RATE=60/minute
VAGON_STREAM_ID=
VAGON_STREAM_URL=

# Optional shared cache (Redis/Valkey). When set (and redis-py is installed), Django uses RedisCache
# for the default + watt_session caches — a real cache shared across all gunicorn workers. REQUIRED in
# multi-worker prod so a Unity session ticket minted by one worker is redeemable by another (otherwise
# the per-process LocMemCache 404s the redeem). Unset -> falls back to LocMemCache + Postgres DB cache.
# DO managed Valkey: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Content Factory service-to-service calls
CONTENT_FACTORY_URL=http://localhost:8001
CONTENT_FACTORY_API_KEY=

# MLAI Tools GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Keep OAuth credentials for connect/reconnect and repo listing.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/callback/github

# Core providers
OPENAI_API_KEY=
GEMINI_API_KEY=
