  "rules": {
    "selection": "One or more actions across any groups describe one block of volunteer time. Apply its duration once.",
    "other": "When other is selected, require a short description of the unlisted work.",
    "badge_candidates": "An action may refer approved work to an existing badge rule. Each rule still requires its own evidence, thresholds and visibility checks.",
    "cross_cutting_badges": [
      "hello.deliver",
      "hello.steady"
    ],
    "automatic_paths": "Introductions, inductions attended, event attendance, routine boosts, founder updates and existing programme rewards keep their own paths. Receiving a pass, purchase, refund, balance adjustment or level bonus is outside this time form."
