                },
                "strategy_exhausted": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "const": 1
                    },
                    "rung": {
                      "enum": [
                        "adopt",
                        "native_collection",
                        "deterministic",
                        "model_adapter",
                        "agent"
                      ]
                    },
                    "goal_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "binding": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "failure_code": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "evidence_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
