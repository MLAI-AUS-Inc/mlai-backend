                  "attempts"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "blocked",
                      "cancelled",
                      "completed",
                      "failed",
                      "pending",
                      "running",
                      "skipped"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
