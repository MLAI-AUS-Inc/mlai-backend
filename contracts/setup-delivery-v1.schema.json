                },
                "source_sha": {
                  "$ref": "#/$defs/bounded"
                },
                "status": {
                  "$ref": "#/$defs/bounded"
                },
                "tech_stack": {
                  "$ref": "#/$defs/bounded"
                },
                "updated_file_count": {
                  "$ref": "#/$defs/bounded"
                },
                "user_action": {
                  "$ref": "#/$defs/bounded"
                },
                "user_action_count": {
                  "$ref": "#/$defs/bounded"
                },
                "verification_kit_required": {
                  "$ref": "#/$defs/bounded"
                },
                "usage": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "const": 1
                    },
                    "run_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "state_version": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "model_calls": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "tokens": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "builds": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "previews": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "provider_seconds": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "active_seconds": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    "model_usd": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1000000000000
                    }
                  },
                  "required": [
                    "version",
                    "run_id",
                    "generation",
                    "state_version",
                    "model_calls",
                    "tokens",
                    "builds",
                    "previews",
                    "provider_seconds",
                    "active_seconds",
                    "model_usd"
