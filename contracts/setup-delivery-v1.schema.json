              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/bounded"
              },
              "maxProperties": 512
            },
            "acceptance_summary": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/bounded"
              },
              "maxProperties": 512
            }
