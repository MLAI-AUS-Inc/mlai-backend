  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        }
      ]
    },
    "bounded": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/bounded"
          }
        },
        {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "maxLength": 256,
            "not": {
              "enum": [
                "access_token",
                "ack",
                "acked_at",
                "acknowledgment",
                "api_key",
                "authorization",
                "command",
                "content",
                "cookies",
                "credentials",
                "delivery_intents",
                "delivery_journal",
                "delivery_receipts",
                "delivery_v1",
                "detail",
                "details",
                "diff",
                "error",
                "error_excerpt",
                "error_message",
                "excerpt",
                "file_content",
                "file_contents",
                "github_access_token",
                "github_token",
                "headers",
                "html",
                "journal",
                "lease",
                "leases",
                "log_excerpt",
                "log_tail",
                "logs",
                "markup",
                "message",
                "output",
                "output_excerpt",
                "output_tail",
                "password",
                "patch",
                "payload_sha256",
                "private_key",
                "raw_output",
                "raw_response",
                "refresh_token",
                "response_body",
                "route_source",
                "script",
                "service_credentials",
                "snippet",
                "source",
                "source_code",
                "source_content",
                "stack_trace",
                "state_sha256",
                "stderr",
                "stderr_tail",
                "stdout",
                "stdout_tail",
                "template",
                "template_body",
                "token",
                "traceback"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/bounded"
          }
        }
      ]
